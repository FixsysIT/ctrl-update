{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contentHash", "titleNl", "summaryNl", "whyNl", "titleEn", "summaryEn", "whyEn", "categories", "kind", "tier", "confidence", "reasonNl", "reasonEn"],
        "properties": {
          "id": { "type": "string" },
          "contentHash": { "type": "string" },
          "titleNl": { "type": "string" },
          "summaryNl": { "type": "string" },
          "whyNl": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "titleEn": { "type": "string" },
          "summaryEn": { "type": "string" },
          "whyEn": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "categories": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
          "kind": { "type": "string", "enum": ["wijziging", "nieuws", "analyse", "handleiding", "naslag"] },
          "tier": { "type": "string", "enum": ["action", "watch", "info"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasonNl": { "type": "string" },
          "reasonEn": { "type": "string" }
        }
      }
    }
  }
}
