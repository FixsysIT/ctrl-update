  "dateTriggers": {
    "_comment": "Bepaalt hoe een datum in de tekst gelabeld wordt. De woorden worden gezocht in de ~80 tekens voor de datum. Volgorde telt: de eerste groep die matcht wint.",
    "deadline": {
      "label": "DEADLINE",
      "terms": [ "required by", "no later than", "not later than", "deadline", "before", "until", "prior to", "must be completed", "uiterlijk" ]
    },
    "retirement": {
      "label": "STOPT",
